# Copie para backend/.env.aiven (fica fora do git) e preencha com os dados do
# Aiven. Usado só pelos comandos "npm run aiven:*", que preparam o banco de
# produção a partir da sua máquina. O .env de desenvolvimento não é tocado.
#
# HOST e PORTA: painel do Aiven > serviço MySQL > Connection information.
# O certificado precisa estar em backend/prisma/certificados/aiven-ca.pem.

# Conta de administrador do Aiven (avnadmin): cria tabelas e a conta abaixo
DATABASE_URL_MIGRACAO="mysql://avnadmin:SENHA_DO_AVNADMIN@HOST:PORTA/vitrine_db?sslcert=certificados/aiven-ca.pem&sslaccept=strict"

# Conta restrita que a API vai usar no Render. Invente a senha: 16+ caracteres,
# só letras e números (sem símbolos, para não precisar escapar na URL)
DATABASE_URL="mysql://vitrine_app:INVENTE_UMA_SENHA_LONGA@HOST:PORTA/vitrine_db?sslcert=certificados/aiven-ca.pem&sslaccept=strict"

# A API conecta de fora do Aiven, então a conta precisa aceitar qualquer endereço
BANCO_HOST_CONTA="%"

# Só para "npm run aiven:seed" (dados de demonstração). O seed APAGA as tabelas
# antes de inserir: rode apenas na primeira vez, com o banco vazio.
TERMOS_VERSAO="1.1"
ADMIN_NOME="Administrador"
ADMIN_EMAIL="admin@vitrinelocal.com.br"
ADMIN_SENHA="defina-uma-senha-forte"
DEMO_EMPREENDEDOR_SENHA="defina-uma-senha-forte"
