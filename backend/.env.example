PORT=3001
NODE_ENV=development

# Duas contas do MySQL. Formato: mysql://USUARIO:SENHA@HOST:PORTA/BANCO
#
# Conta da aplicação: só lê e grava linhas no vitrine_db. Use uma senha longa
# e aleatória (16 caracteres ou mais, só letras e números para não precisar
# escapar na URL). Ela é criada por "npm run banco:criar-usuario".
DATABASE_URL="mysql://vitrine_app:TROQUE_POR_UMA_SENHA_LONGA@localhost:3306/vitrine_db"
# Conta de administrador (root): usada só para criar a conta acima e rodar as
# migrations. A API nunca se conecta com ela.
# XAMPP sem senha:        mysql://root:@localhost:3306/vitrine_db
# MySQL Server com senha: mysql://root:SUA_SENHA@localhost:3306/vitrine_db
DATABASE_URL_MIGRACAO="mysql://root:SUA_SENHA@localhost:3306/vitrine_db"

# Origens autorizadas a chamar a API (separadas por vírgula).
# Em desenvolvimento, vazio libera o Vite em localhost:5173.
# Em produção é obrigatório: vazio bloqueia todo acesso cross-origin.
CORS_ORIGINS=""

# Autenticação
# Troque por uma chave longa e aleatória em produção
JWT_SECRET="troque-esta-chave-por-uma-longa-e-aleatoria"
JWT_EXPIRES_IN="8h"

# Administrador criado pelo seed
ADMIN_NOME="Administrador"
ADMIN_EMAIL="admin@vitrinelocal.com.br"
ADMIN_SENHA="Admin@2026"

# Senha da conta de empreendedor de demonstração criada pelo seed
DEMO_EMPREENDEDOR_SENHA="Carlos@2026"

# Versão vigente dos termos (deve bater com o cabeçalho dos arquivos .md)
TERMOS_VERSAO="1.0"
