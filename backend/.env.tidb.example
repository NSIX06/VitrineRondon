# Copie para backend/.env.tidb (fica fora do git) e preencha com os dados do
# TiDB Cloud Starter. Usado só pelos comandos "npm run tidb:*", que preparam o
# banco de produção a partir da sua máquina. O .env de desenvolvimento não é tocado.
#
# Onde achar os dados: tidbcloud.com > My TiDB > seu cluster > Connect >
# "Connection Type: Public". Copie HOST, a porta (4000) e o usuário, que já vem
# com o prefixo do cluster (ex.: 3pTAoNNegb47Uc8.root). Gere a senha ali.
#
# TLS: obrigatório no TiDB. O certificado é de uma autoridade pública, então não
# precisa de arquivo: basta sslaccept=strict (confere a autoridade e o nome).

# Conta de administrador (PREFIXO.root): cria o banco, as tabelas e a conta abaixo
DATABASE_URL_MIGRACAO="mysql://PREFIXO.root:SENHA_DO_ROOT@HOST:4000/vitrine_db?sslaccept=strict"

# Conta restrita que a API vai usar no Render. Use o MESMO prefixo e invente a
# senha: 16+ caracteres, só letras e números (sem símbolos, para não escapar na URL)
DATABASE_URL="mysql://PREFIXO.vitrine_app:INVENTE_UMA_SENHA_LONGA@HOST:4000/vitrine_db?sslaccept=strict"

# A API conecta de fora do TiDB, então a conta precisa aceitar qualquer endereço
BANCO_HOST_CONTA="%"

# Só para "npm run tidb:seed" (dados de demonstração). O seed APAGA as tabelas
# antes de inserir: rode apenas na primeira vez, com o banco vazio.
TERMOS_VERSAO="1.1"
ADMIN_NOME="Administrador"
ADMIN_EMAIL="admin@vitrinelocal.com.br"
ADMIN_SENHA="defina-uma-senha-forte"
DEMO_EMPREENDEDOR_SENHA="defina-uma-senha-forte"
