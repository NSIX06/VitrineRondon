# Copie para backend/.env.nuvem (fica fora do git) e preencha com os dados do
# banco MySQL na nuvem (aqui, o add-on MySQL do Clever Cloud). Usado só pelos
# comandos "npm run nuvem:*", que preparam o banco de produção a partir da sua
# máquina. O .env de desenvolvimento não é tocado.
#
# Onde achar os dados: console do Clever Cloud > seu add-on MySQL >
# "Environment variables" (MYSQL_ADDON_HOST, MYSQL_ADDON_PORT, MYSQL_ADDON_DB,
# MYSQL_ADDON_USER e MYSQL_ADDON_PASSWORD).
#
# Certificado: o Clever Cloud não oferece o arquivo da CA para download. Depois
# de preencher a URL abaixo, rode "npm run nuvem:certificado": ele lê a cadeia
# direto do servidor e salva prisma/certificados/nuvem-ca.pem.

# O plano gratuito (DEV) tem um usuário só e poucas conexões: a mesma conta
# serve para as migrations e para a API, e o connection_limit fica baixo.
DATABASE_URL_MIGRACAO="mysql://USUARIO:SENHA@HOST:PORTA/BANCO?sslcert=certificados/nuvem-ca.pem&sslaccept=strict&connection_limit=1"
DATABASE_URL="mysql://USUARIO:SENHA@HOST:PORTA/BANCO?sslcert=certificados/nuvem-ca.pem&sslaccept=strict&connection_limit=3"

# Só para "npm run nuvem:seed" (dados de demonstração). O seed APAGA as tabelas
# antes de inserir: rode apenas na primeira vez, com o banco vazio.
TERMOS_VERSAO="1.1"
ADMIN_NOME="Administrador"
ADMIN_EMAIL="admin@vitrinelocal.com.br"
ADMIN_SENHA="defina-uma-senha-forte"
DEMO_EMPREENDEDOR_SENHA="defina-uma-senha-forte"
