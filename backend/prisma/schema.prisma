// Schema do banco de dados do VitrineLocal
// Banco: MySQL (vitrine_db)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Microempreendedor cadastrado na vitrine
model Empreendedor {
  id                   Int                  @id @default(autoincrement())
  nomeNegocio          String               @map("nome_negocio") @db.VarChar(150)
  responsavel          String               @db.VarChar(150)
  descricao            String?              @db.Text
  categoria            String               @default("Geral") @db.VarChar(50)
  cidade               String               @db.VarChar(100)
  // Localização (opcional): permite exibir o negócio no mapa
  endereco             String?              @db.VarChar(200)
  numero               String?              @db.VarChar(20)
  complemento          String?              @db.VarChar(100)
  bairro               String?              @db.VarChar(100)
  estado               String               @default("MT") @db.VarChar(2)
  cep                  String?              @db.VarChar(9)
  latitude             Float?
  longitude            Float?
  exibirEndereco       Boolean              @default(true) @map("exibir_endereco")
  // Dono do negócio (opcional: cadastros antigos ficam sem dono até um admin vincular)
  usuarioId            Int?                 @unique @map("usuario_id")
  usuario              Usuario?             @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  whatsapp             String               @db.VarChar(30)
  instagram            String?              @db.VarChar(100)
  fotoUrl              String?              @map("foto_url") @db.VarChar(500)
  // Foto do quadrado do perfil (logo ou rosto de quem atende); sem ela, as iniciais
  logoUrl              String?              @map("logo_url") @db.VarChar(500)
  // Ponto da foto que fica à vista quando ela é cortada ("50% 30%"), escolhido
  // pelo dono arrastando a prévia; vale em todos os lugares onde a foto aparece
  fotoFoco             String?              @map("foto_foco") @db.VarChar(20)
  logoFoco             String?              @map("logo_foco") @db.VarChar(20)
  ativo                Boolean              @default(true)
  // Plano em vigor, copiado da assinatura vigente para a vitrine não precisar
  // juntar tabelas a cada listagem. Só o serviço de assinaturas escreve aqui.
  planoAtual           String               @default("NENHUM") @map("plano_atual") @db.VarChar(20) // NENHUM | nome do plano
  emDestaque           Boolean              @default(false) @map("em_destaque")
  // Até quando o negócio aparece ao público: fim do período pago da assinatura
  // vigente. Nulo ou no passado = fora da vitrine (rascunho, aguardando
  // pagamento ou assinatura vencida). Os dados continuam guardados.
  publicadoAte         DateTime?            @map("publicado_ate")
  // Quando o negócio apareceu na vitrine pela primeira vez (primeira
  // assinatura paga). Não muda em renovações nem quando ele volta depois de
  // sair: é o que marca o selo "Novo na vitrine" nos primeiros dias.
  publicadoDesde       DateTime?            @map("publicado_desde")
  // Consentimento para a VitrineRondon usar nome, fotos e produtos em
  // divulgações nas redes oficiais (benefício do plano Destaque)
  autorizaDivulgacao   Boolean              @default(false) @map("autoriza_divulgacao")
  autorizaDivulgacaoEm DateTime?            @map("autoriza_divulgacao_em")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  produtos             Produto[]
  // Horário de atendimento: sem nenhum intervalo, a página mostra "Indisponível"
  horarios             HorarioAtendimento[]
  contatos             Contato[]
  assinaturas          Assinatura[]
  divulgacoes          Divulgacao[]
  metricas             MetricaDiaria[]

  // A vitrine filtra sempre por negócio ativo, e daí por categoria ou bairro.
  // "cidade" fica de fora de propósito: a consulta usa LIKE com % na frente,
  // que o MySQL não resolve por índice.
  @@index([ativo, categoria])
  @@index([ativo, bairro])
  // Ordenação "destaques primeiro" nas listagens
  @@index([ativo, emDestaque])
  // A vitrine pública só mostra negócio com assinatura em vigor
  @@index([ativo, publicadoAte])
  @@map("empreendedores")
}

// Produto ou serviço oferecido por um empreendedor
model Produto {
  id             Int          @id @default(autoincrement())
  nome           String       @db.VarChar(150)
  descricao      String?      @db.Text
  preco          Float
  tipo           String       @default("produto") @db.VarChar(20) // "produto" | "servico"
  imagem         String?      @db.VarChar(500)
  disponivel     Boolean      @default(true)
  empreendedorId Int          @map("empreendedor_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  empreendedor   Empreendedor @relation(fields: [empreendedorId], references: [id], onDelete: Cascade)

  @@index([empreendedorId])
  // Quem não é dono nem admin só enxerga item disponível, e a vitrine separa
  // produto de serviço
  @@index([disponivel, tipo])
  @@map("produtos")
}

// Mensagem enviada pela comunidade (opcionalmente direcionada a um empreendedor)
model Contato {
  id             Int           @id @default(autoincrement())
  nome           String        @db.VarChar(150)
  email          String        @db.VarChar(150)
  telefone       String?       @db.VarChar(30)
  mensagem       String        @db.Text
  lido           Boolean       @default(false)
  empreendedorId Int?          @map("empreendedor_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  empreendedor   Empreendedor? @relation(fields: [empreendedorId], references: [id], onDelete: SetNull)

  @@map("contatos")
}

// Conta de acesso. Perfis: COMUM | EMPREENDEDOR | ADMIN
model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String   @db.VarChar(150)
  email     String   @unique @db.VarChar(150)
  telefone  String   @db.VarChar(30)
  senhaHash String   @map("senha_hash") @db.VarChar(100)
  perfil    String   @default("COMUM") @db.VarChar(20)
  ativo     Boolean  @default(true)
  // Última troca de senha: sessões (JWT) emitidas antes dela deixam de valer
  senhaAlteradaEm DateTime? @map("senha_alterada_em")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  empreendedor Empreendedor?
  aceites      AceiteTermos[]
  logs         LogAuditoria[]
  redefinicoes RedefinicaoSenha[]

  @@map("usuarios")
}

// Avisos do gateway de pagamento já processados (id do evento): um aviso
// repetido é confirmado sem ser aplicado de novo.
model EventoWebhook {
  id         String   @id @db.VarChar(100)
  recebidoEm DateTime @default(now()) @map("recebido_em")

  @@map("eventos_webhook")
}

// Sessão encerrada pelo botão Sair: o token (identificado pelo jti) deixa de
// valer antes de expirar. A linha pode ser apagada depois de expiraEm.
model SessaoEncerrada {
  jti      String   @id @db.VarChar(36)
  expiraEm DateTime @map("expira_em")

  @@index([expiraEm])
  @@map("sessoes_encerradas")
}

// Pedido de "esqueci a senha". Guarda só o hash (SHA-256) do código do link:
// quem lê o banco não consegue usar o link. Vale 30 minutos e uma vez só.
model RedefinicaoSenha {
  id        Int       @id @default(autoincrement())
  usuarioId Int       @map("usuario_id")
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiraEm  DateTime  @map("expira_em")
  usadoEm   DateTime? @map("usado_em")
  createdAt DateTime  @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("redefinicoes_senha")
}

// Histórico de aceites dos termos. Nunca é sobrescrito: cada versão aceita gera uma linha.
model AceiteTermos {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @map("usuario_id")
  tipoTermo String   @map("tipo_termo") @db.VarChar(30) // TERMOS_DE_USO | POLITICA_PRIVACIDADE
  versao    String   @db.VarChar(20)
  aceito    Boolean  @default(true)
  ip        String?  @db.VarChar(60)
  userAgent String?  @map("user_agent") @db.VarChar(300)
  criadoEm  DateTime @default(now()) @map("created_at")
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("aceites_termos")
}

// Auditoria. Escrita apenas pelo backend; nunca guarda senha ou token.
model LogAuditoria {
  id            Int      @id @default(autoincrement())
  usuarioId     Int?     @map("usuario_id")
  usuarioNome   String?  @map("usuario_nome") @db.VarChar(150)
  acao          String   @db.VarChar(50)
  tipoEntidade  String?  @map("tipo_entidade") @db.VarChar(50)
  entidadeId    Int?     @map("entidade_id")
  descricao     String?  @db.Text
  valoresAntes  Json?    @map("valores_antes")
  valoresDepois Json?    @map("valores_depois")
  ip            String?  @db.VarChar(60)
  userAgent     String?  @map("user_agent") @db.VarChar(300)
  status        String   @default("SUCESSO") @db.VarChar(20) // SUCESSO | ERRO
  erroMensagem  String?  @map("erro_mensagem") @db.Text
  criadoEm      DateTime @default(now()) @map("created_at")
  usuario       Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([usuarioId])
  @@index([acao])
  @@index([tipoEntidade])
  @@index([criadoEm])
  @@map("logs_auditoria")
}

// Intervalos de atendimento informados pelo empreendedor.
// Um dia pode ter vários (ex.: 08:00-12:00 e 13:00-17:00). "Aberto agora" é
// calculado a partir daqui, no fuso de Rondonópolis (America/Cuiaba).
model HorarioAtendimento {
  id             Int          @id @default(autoincrement())
  empreendedorId Int          @map("empreendedor_id")
  diaSemana      Int          @map("dia_semana") @db.TinyInt // 0 = domingo ... 6 = sábado
  abre           String       @db.VarChar(5) // "08:00"
  fecha          String       @db.VarChar(5) // "12:00"
  empreendedor   Empreendedor @relation(fields: [empreendedorId], references: [id], onDelete: Cascade)

  @@index([empreendedorId, diaSemana])
  @@map("horarios_atendimento")
}

// Pergunta frequente da central de ajuda. A área pública mostra só as ativas;
// a administração vê e edita todas.
model PerguntaFrequente {
  id        Int      @id @default(autoincrement())
  pergunta  String   @db.VarChar(300)
  resposta  String   @db.Text
  categoria String?  @db.VarChar(80)
  ordem     Int      @default(0)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // A leitura pública filtra por ativo e ordena por ordem
  @@index([ativo, ordem])
  @@map("perguntas_frequentes")
}

// ---------------------------------------------------------------------------
// Assinaturas
// ---------------------------------------------------------------------------

// Planos à venda. Vêm sempre desta tabela (nunca fixos no código): um plano
// novo, anual ou gratuito é uma linha a mais, não uma mudança de regra.
model Plano {
  id                Int          @id @default(autoincrement())
  nome              String       @unique @db.VarChar(30) // ESSENCIAL | DESTAQUE | ...
  titulo            String       @db.VarChar(60) // "VitrineRondon Essencial"
  chamada           String?      @db.VarChar(160) // frase curta da página de planos
  descricao         String?      @db.Text
  precoCentavos     Int          @map("preco_centavos") // 5000 = R$ 50,00
  ciclo             String       @default("MONTHLY") @db.VarChar(20) // ciclo do gateway
  // O que o plano libera. A vitrine decide pelo plano, não pelo nome dele.
  destaque          Boolean      @default(false) // selo, prioridade e seção de destaques
  metricasAmpliadas Boolean      @default(false) @map("metricas_ampliadas")
  divulgacao        Boolean      @default(false) // pode entrar no calendário de divulgação
  ordem             Int          @default(0)
  ativo             Boolean      @default(true)
  // Produto correspondente no gateway (AbacatePay), criado na primeira venda
  gatewayProdutoId  String?      @map("gateway_produto_id") @db.VarChar(100)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  assinaturas       Assinatura[]

  @@map("planos")
}

// Assinatura de um negócio. O status só muda pelo serviço de assinaturas
// (webhook, conciliação com o gateway ou simulação fora de produção).
model Assinatura {
  id                  Int          @id @default(autoincrement())
  empreendedorId      Int          @map("empreendedor_id")
  planoId             Int          @map("plano_id")
  status              String       @default("PENDENTE") @db.VarChar(20) // PENDENTE | ATIVA | INADIMPLENTE | CANCELADA
  // No AbacatePay o checkout (bill_...) nasce antes; a assinatura (subs_...)
  // só passa a existir depois do primeiro pagamento
  gatewayCheckoutId   String?      @unique @map("gateway_checkout_id") @db.VarChar(100)
  gatewayAssinaturaId String?      @unique @map("gateway_assinatura_id") @db.VarChar(100)
  checkoutUrl         String?      @map("checkout_url") @db.VarChar(500)
  inicioEm            DateTime?    @map("inicio_em")
  proximaCobranca     DateTime?    @map("proxima_cobranca")
  // Fim do período já pago (próxima cobrança + um dia de folga para o aviso
  // de renovação chegar). Cancelada pelo empreendedor, vale até esta data;
  // cobrança recusada ou plano substituído encerram na hora.
  vigenteAte          DateTime?    @map("vigente_ate")
  canceladaEm         DateTime?    @map("cancelada_em")
  criadoEm            DateTime     @default(now()) @map("created_at")
  atualizadoEm        DateTime     @updatedAt @map("updated_at")
  empreendedor        Empreendedor @relation(fields: [empreendedorId], references: [id], onDelete: Cascade)
  plano               Plano        @relation(fields: [planoId], references: [id])

  @@index([empreendedorId, status])
  @@index([planoId])
  @@map("assinaturas")
}

// Divulgação nas redes oficiais (só registro nesta fase, sem integração).
// Não há cota de posts: entra conforme calendário, critérios e aprovação.
model Divulgacao {
  id             Int          @id @default(autoincrement())
  empreendedorId Int          @map("empreendedor_id")
  tipo           String       @db.VarChar(30) // NEGOCIO | PRODUTO | SERVICO | CAMPANHA | INSTITUCIONAL
  titulo         String       @db.VarChar(150)
  canal          String?      @db.VarChar(40) // Instagram, Facebook...
  status         String       @default("PLANEJADA") @db.VarChar(20) // PLANEJADA | PUBLICADA | CANCELADA
  publicadaEm    DateTime?    @map("publicada_em")
  link           String?      @db.VarChar(500)
  alcance        Int?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  empreendedor   Empreendedor @relation(fields: [empreendedorId], references: [id], onDelete: Cascade)

  @@index([empreendedorId])
  @@map("divulgacoes")
}

// Desempenho do negócio, somado por dia. Não guarda quem visitou (sem
// cookies nem IP): só quantas vezes cada coisa aconteceu.
model MetricaDiaria {
  id             Int          @id @default(autoincrement())
  empreendedorId Int          @map("empreendedor_id")
  dia            DateTime     @db.Date
  // VISUALIZACAO_PERFIL | CLIQUE_WHATSAPP | CLIQUE_TELEFONE | CLIQUE_ENDERECO |
  // CLIQUE_INSTAGRAM | VISUALIZACAO_PRODUTO | IMPRESSAO_DESTAQUE
  tipo           String       @db.VarChar(30)
  // Produto, quando o evento é de um item; 0 para o negócio como um todo
  // (0 e não nulo: o MySQL não trata nulos como iguais na chave única)
  referenciaId   Int          @default(0) @map("referencia_id")
  quantidade     Int          @default(0)
  empreendedor   Empreendedor @relation(fields: [empreendedorId], references: [id], onDelete: Cascade)

  @@unique([empreendedorId, dia, tipo, referenciaId])
  @@index([empreendedorId, dia])
  @@map("metricas_diarias")
}
